{
  "name": "@zkmake/three-audit",
  "version": "0.6.1",
  "description": "Scene checks for three.js: triangle counts, cost census, NaN normals, z-fighting, black frames, a one-frame draw-call ledger, and per-app budgets with Vitest matchers. Zero dependencies.",
  "keywords": [
    "audit",
    "budgets",
    "devtools",
    "draw-calls",
    "lint",
    "r3f",
    "three",
    "threejs",
    "triangles",
    "vitest",
    "z-fighting"
  ],
  "homepage": "https://zkmake.github.io/three-kit/three-audit/",
  "bugs": "https://github.com/zkmake/three-kit/issues",
  "license": "MIT",
  "author": "Zubin Khavarian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkmake/three-kit.git",
    "directory": "packages/three-audit"
  },
  "bin": {
    "three-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/vitest.js"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./budgets": "./dist/budgets.js",
    "./node": "./dist/node.js",
    "./vitest": "./dist/vitest.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "ci:test": "vitest run",
    "ci:typecheck": "tsc",
    "pack:check": "npm pack --dry-run",
    "test": "vitest watch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "draco3dgltf": "catalog:",
    "meshoptimizer": "catalog:",
    "publint": "catalog:",
    "three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "draco3dgltf": ">=1.5",
    "meshoptimizer": ">=0.21",
    "three": ">=0.160",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "draco3dgltf": {
      "optional": true
    },
    "meshoptimizer": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
