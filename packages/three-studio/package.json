{
  "name": "@zkmake/three-studio",
  "version": "0.2.0",
  "description": "A dev page for three.js scenes: areas, variants and camera views from the URL, an orbit rig, a draw-call readout, audit helpers and screenshots an agent can take, plus a CLI to save and diff them. Vanilla three and React Three Fiber.",
  "keywords": [
    "devtools",
    "mockups",
    "r3f",
    "react-three-fiber",
    "screenshots",
    "studio",
    "three",
    "threejs",
    "visual-regression"
  ],
  "homepage": "https://zkmake.github.io/three-kit/three-studio/",
  "bugs": "https://github.com/zkmake/three-kit/issues",
  "license": "MIT",
  "author": "Zubin Khavarian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkmake/three-kit.git",
    "directory": "packages/three-studio"
  },
  "bin": {
    "three-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node.js",
    "./react": "./dist/react.js",
    "./ui": "./dist/ui.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "ci:test": "vitest run",
    "ci:typecheck": "tsc",
    "pack:check": "npm pack --dry-run",
    "test": "vitest watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@zkmake/three-audit": "^0.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@react-three/fiber": "catalog:",
    "@react-three/test-renderer": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "three": ">=0.170"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
