{
  "name": "@zkmake/three-textures",
  "version": "0.0.0",
  "description": "A dev panel for the textures in a three.js scene: see them, download them, paint them, swap them back in live — compressed (KTX2) textures included. Vanilla three and React Three Fiber.",
  "keywords": [
    "devtools",
    "ktx2",
    "r3f",
    "react-three-fiber",
    "texture",
    "textures",
    "three",
    "threejs"
  ],
  "homepage": "https://github.com/zkmake/three-kit/tree/main/packages/three-textures#readme",
  "bugs": "https://github.com/zkmake/three-kit/issues",
  "license": "MIT",
  "author": "Zubin Khavarian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkmake/three-kit.git",
    "directory": "packages/three-textures"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./ui": "./dist/ui.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "ci:test": "vitest run",
    "ci:typecheck": "tsc",
    "pack:check": "npm pack --dry-run",
    "test": "vitest watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@zkmake/three-meter": "^0.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@react-three/fiber": "catalog:",
    "@react-three/test-renderer": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "three": ">=0.170"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
