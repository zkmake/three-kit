{
  "name": "three-kit",
  "private": true,
  "description": "zkmake's three.js tools, each published separately under @zkmake/*.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "ci:format": "oxfmt --check .",
    "ci:lint": "oxlint --deny-warnings .",
    "ci:test": "vitest run",
    "ci:typecheck": "bun run --filter '*' typecheck",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "pack:check": "bun run --filter './packages/*' pack:check",
    "release": "bun run build && changeset publish",
    "test": "vitest watch",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
