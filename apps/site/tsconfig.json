{
  "extends": "@config/typescript/tsconfig-app.json",
  "compilerOptions": {
    "types": ["astro/client"],
    "paths": {
      // Source, not dist, to match the Vite alias: see astro.config.ts.
      "@zkmake/three-textures": ["../../packages/three-textures/src/index.ts"],
      "@zkmake/three-textures/ui": ["../../packages/three-textures/src/ui/index.ts"],
      "@zkmake/three-textures/react": ["../../packages/three-textures/src/react/index.tsx"],
      "@zkmake/three-meter": ["../../packages/three-meter/src/index.ts"],
      "@zkmake/three-meter/*": ["../../packages/three-meter/src/*/index.ts"]
    }
  },
  "include": ["src", "astro.config.ts"]
}
