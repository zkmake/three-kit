---
import Bar from "../components/Bar.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Base from "../layouts/Base.astro";
import { LIBRARIES, REPO_URL } from "../libraries.ts";
---

<Base
  title="three-kit · profile, debug and speed up three.js scenes"
  description="Tools that find and fix what makes a three.js scene slow or broken: a live frame-cost HUD, a panel to paint and swap textures in the running scene, z-fighting and broken-geometry checks for tests and CI, and batching that cuts draw calls and triangles. Vanilla three and React Three Fiber."
  shareDescription="Find and fix what makes a three.js scene slow or broken: frame costs, live texture edits, geometry checks and draw-call batching."
  kind="page"
>
  <Bar />
  <main class="home">
    <section class="hero">
      <h1 class="hero__title">Find and fix what makes a three.js scene slow or broken.</h1>
      <p class="hero__lede">
        Measure what each frame costs, paint and swap textures while the scene runs, catch
        z-fighting and bad geometry in your tests, and cut draw calls and triangles. Four small
        packages: use one or all, with plain three or React Three Fiber.
      </p>
    </section>
    <ul class="cards">
      {
        LIBRARIES.map((lib) => (
          <li class="card">
            <div class="card__head">
              <img src={`/${lib.name}/favicon.svg`} alt="" width="24" height="24" />
              <a class="card__name" href={`/${lib.name}/`}>
                {lib.name}
              </a>
              <span class="card__version">{lib.version}</span>
            </div>
            <p class="card__job">{lib.job}</p>
            <p class="card__summary">{lib.summary}</p>
            <InstallCommand library={lib.name} />
            <div class="card__links">
              {lib.demo && <a href={`/${lib.name}/`}>live demo →</a>}
              <a href={lib.demo ? `/${lib.name}/docs/` : `/${lib.name}/`}>docs →</a>
            </div>
          </li>
        ))
      }
    </ul>
  </main>
  <footer class="page-footer">
    <a href={REPO_URL} target="_blank" rel="noreferrer">github.com/zkmake/three-kit</a>
    <span>
      by <a href="https://zubin.dev" rel="author noreferrer" target="_blank">Zubin Khavarian</a> · MIT
    </span>
  </footer>
</Base>

<script>
  import { startInstall } from "../scripts/install.ts";
  import { startTheme } from "../scripts/theme.ts";

  startTheme();
  startInstall();
</script>
