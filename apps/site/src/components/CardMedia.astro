---
/**
 * The top of a landing card. A library with a demo shows a clip of it (`preview.mp4`, made by
 * `bun run previews`; scripts/card-media.ts plays it while on screen); the others get a drawing
 * of what they do, with a chip naming what the package adds. Decorative: the card's text says the
 * same, so it's hidden from screen readers; a click lands on the card's own link.
 */
import { type Library } from "../libraries.ts";
import { url } from "../paths.ts";

type Props = { library: Library };

const { library } = Astro.props;
const tiles = Array.from({ length: 64 }, (_, index) => index);
/** three-quality: one canvas at three pixel ratios, its pixels coarser at each step down. */
const ratios = [
  { across: 9, label: "1.5×" },
  { across: 7, label: "1.25×" },
  { across: 5, label: "1×" },
].map((ratio, column) => {
  const pitch = 140 / ratio.across;

  return {
    ...ratio,
    cells: Array.from({ length: ratio.across ** 2 }, (_, index) => ({
      size: pitch - 2,
      tone: (Math.floor(index / ratio.across) + (index % ratio.across) + column) % 4,
      x: (index % ratio.across) * pitch,
      y: Math.floor(index / ratio.across) * pitch,
    })),
    x: 60 + column * 190,
  };
});
---

<div class="card__media" aria-hidden="true">
  {
    library.demo ? (
      <video
        class="card__video"
        muted
        loop
        playsinline
        preload="none"
        width="640"
        height="360"
        poster={url(`${library.name}/preview.webp`)}
        data-card-video
      >
        <source src={url(`${library.name}/preview.mp4`)} type="video/mp4" />
      </video>
    ) : library.name === "three-audit" ? (
      <svg class="card__art" viewBox="0 0 640 360" role="presentation">
        <defs>
          <pattern
            id="zfight"
            width="22"
            height="22"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(-32)"
          >
            <rect width="22" height="22" class="art-a" />
            <path d="M0 4h22v5H0zM0 14h9v3H0zm13 1h9v4h-9z" class="art-b" />
          </pattern>
        </defs>
        <g transform="translate(70 70)">
          <path d="M0 110 120 40l140 70-120 70Z" class="art-plane" />
          <path d="M70 120 170 62l110 56-100 58Z" fill="url(#zfight)" class="art-fight" />
          <path d="M70 120 170 62l110 56-100 58Z" class="art-outline" />
          <g class="art-normal">
            <path d="M40 104v-58" />
            <path d="m33 54 7-12 7 12" />
          </g>
          <text x="22" y="30" class="art-tag">NaN</text>
        </g>
        <g class="art-log" transform="translate(372 120)">
          <text y="0"><tspan class="art-ok">✓</tspan> no NaN normals</text>
          <text y="30"><tspan class="art-bad">✗</tspan> z-fighting</text>
          <text y="54" class="art-dim">plinth ↔ wall</text>
          <text y="78" class="art-dim">y = 0.000 · 4 tris</text>
        </g>
      </svg>
    ) : library.name === "three-studio" ? (
      <svg class="card__art" viewBox="0 0 640 360" role="presentation">
        <rect x="60" y="40" width="520" height="280" rx="10" class="art-plane" />
        <g transform="translate(76 56)">
          <rect width="58" height="22" rx="5" class="art-m1" />
          <rect x="64" width="58" height="22" rx="5" class="art-chip" />
          <rect y="28" width="44" height="22" rx="5" class="art-chip" />
          <rect x="50" y="28" width="44" height="22" rx="5" class="art-m2" />
          <rect x="100" y="28" width="44" height="22" rx="5" class="art-chip" />
          <text y="78" class="art-dim">38 calls · 112k tris</text>
        </g>
        <g transform="translate(424 56)">
          <rect width="44" height="22" rx="5" class="art-m1" />
          <rect x="50" width="44" height="22" rx="5" class="art-chip" />
          <rect x="100" width="40" height="22" rx="5" class="art-chip" />
        </g>
        <g transform="translate(320 196)">
          <path d="M0 -62 54 -31 0 0 -54 -31Z" class="art-m1" />
          <path d="M-54 -31 0 0 0 62 -54 31Z" class="art-m0" />
          <path d="M54 -31 0 0 0 62 54 31Z" class="art-m2" />
        </g>
        <text x="320" y="300" text-anchor="middle" class="art-dim">
          ?area=crates&amp;v=steel&amp;view=play
        </text>
      </svg>
    ) : library.name === "three-quality" ? (
      <svg class="card__art" viewBox="0 0 640 360" role="presentation">
        {ratios.map((ratio, column) => (
          <g transform={`translate(${ratio.x} 44)`}>
            {ratio.cells.map((cell) => (
              <rect
                x={cell.x}
                y={cell.y}
                width={cell.size}
                height={cell.size}
                rx="2"
                class={`art-tile art-m${cell.tone}`}
              />
            ))}
            <text x="70" y="172" text-anchor="middle" class={column === 2 ? "" : "art-dim"}>
              {ratio.label}
            </text>
            {column < 2 && <path d="M150 70h30m-10-8 10 8-10 8" class="art-arrow" />}
          </g>
        ))}
        <text x="320" y="264" text-anchor="middle" class="art-dim">
          p90 31 ms → 16.7 ms · on target
        </text>
      </svg>
    ) : library.name === "three-devtools" ? (
      <svg class="card__art" viewBox="0 0 640 360" role="presentation">
        <rect x="60" y="34" width="520" height="34" rx="8" class="art-plane" />
        <text x="80" y="57" class="art-dim">game.example/<tspan class="art-ok">?debug</tspan></text>
        <g transform="translate(60 90)">
          <rect width="236" height="132" rx="8" class="art-plane" />
          <rect x="14" y="14" width="64" height="20" rx="5" class="art-m1" />
          <text x="14" y="62">60 fps · 48 calls</text>
          <text x="14" y="88" class="art-dim">92k / 150k tris</text>
          <text x="14" y="114" class="art-dim">dpr 1.25 · steady</text>
        </g>
        <g class="art-log" transform="translate(330 112)">
          <text y="0"><tspan class="art-dim">›</tspan> tris()</text>
          <text y="26" class="art-dim">92,418</text>
          <text y="56"><tspan class="art-dim">›</tspan> ledger()</text>
          <text y="82" class="art-dim">48 draws · 2 passes</text>
        </g>
        <g transform="translate(60 246)">
          <rect width="112" height="24" rx="5" class="art-chip" />
          <rect x="120" width="112" height="24" rx="5" class="art-chip" />
          <text x="14" y="17" class="art-dim">cameras</text>
          <text x="134" y="17" class="art-dim">textures</text>
        </g>
        <text x="330" y="300" class="art-dim">normal load: one URL check</text>
      </svg>
    ) : (
      <svg class="card__art" viewBox="0 0 640 360" role="presentation">
        <g transform="translate(70 64)">
          {tiles.map((index) => (
            <rect
              x={(index % 8) * 22}
              y={Math.floor(index / 8) * 22}
              width="18"
              height="18"
              rx="3"
              class={`art-tile art-m${(index * 5 + Math.floor(index / 8)) % 4}`}
            />
          ))}
          <text x="0" y="200" class="art-dim">
            64 meshes · 64 draws
          </text>
        </g>
        <path d="M284 142h56m-12-10 12 10-12 10" class="art-arrow" />
        <g transform="translate(380 64)">
          {[0, 1, 2, 3].map((index) => (
            <rect
              x={(index % 2) * 88}
              y={Math.floor(index / 2) * 88}
              width="84"
              height="84"
              rx="6"
              class={`art-cell art-m${index}`}
            />
          ))}
          <text x="0" y="200" class="art-dim">
            bake(group) · 4 draws
          </text>
        </g>
      </svg>
    )
  }
  <span class="card__chip">{library.mediaLabel}</span>
</div>
