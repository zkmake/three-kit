---
/**
 * The demo pages' install card: what the library does (its job and summary, also the page's words
 * for search), the command (tabs and copy, InstallCommand), the first call (`#install-usage`, set
 * per integration by the page), and a slot for "try it" steps.
 */
import { library as libraryEntry, type LibraryName, REPO_URL } from "../libraries.ts";
import { url } from "../paths.ts";
import InstallCommand from "./InstallCommand.astro";

type Props = {
  library: LibraryName;
  /** The first call, before the page picks an integration. */
  usage: string;
  /** Footer tagline. */
  tagline: string;
  /** The corner it sits in: whichever the demo's panels leave free. */
  side: "left" | "right" | "top-right";
};

const { library, usage, tagline, side } = Astro.props;
const { job, summary } = libraryEntry(library);
---

<aside class={`install install--${side}`} aria-labelledby="install-title">
  <h2 class="install__job">{job}</h2>
  <p class="install__summary">{summary}</p>
  <span id="install-title" class="install__title">Install</span>
  <InstallCommand library={library} />
  <p class="install__hint">
    then <code id="install-usage">{usage}</code> — see the{" "}
    <a href={url(`${library}/docs/`)}>README</a> for the rest.
  </p>
  <!-- The demo's note (how to drive it, a renderer switch), filled per integration by demo-page.ts. -->
  <p id="note" class="install__note"></p>
  <slot />
  <footer class="install__footer">
    <span>{tagline}</span>
    <span>
      by <a href="https://zubin.dev" rel="author noreferrer" target="_blank">Zubin Khavarian</a> ·
      <a href={`${REPO_URL}/blob/main/packages/${library}/LICENSE`} target="_blank" rel="noreferrer"
        >MIT</a
      >
    </span>
  </footer>
</aside>
