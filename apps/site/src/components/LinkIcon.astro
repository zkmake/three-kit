---
/** The header's project-link icons (Bar.astro): in the bar, and in the package menu on a phone. */
type Icon = "demo" | "docs" | "github" | "npm" | "npmx";

type Props = { icon: Icon };

const { icon } = Astro.props;
const stroke = icon === "demo" || icon === "docs" || icon === "npmx";
---

<svg
  class={`link__icon${stroke ? " link__icon--stroke" : ""}`}
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  {icon === "demo" && <path d="M7 4v16l13-8Z" />}
  {
    icon === "docs" && (
      <path d="M4 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4ZM20 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7Z" />
    )
  }
  {
    icon === "github" && (
      <path
        fill="currentColor"
        d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.05.78 2.13v3.16c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
      />
    )
  }
  {
    icon === "npm" && (
      <path
        fill="currentColor"
        d="M2 6h20v12H12v2H7v-2H2V6Zm2 2v8h3V9h3v7h2V8H4Zm10 0v8h3V9h3v7h2V8h-8Z"
      />
    )
  }
  {
    icon === "npmx" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3.5" />
        <path d="M15.5 7 11 17" />
        <path d="M7.75 15.75h.5v.5h-.5z" fill="currentColor" />
      </>
    )
  }
</svg>
