---
/**
 * An install command with package-manager tabs (bun first) and a copy button. Every one on a page
 * follows the same pick, which is remembered; scripts/install.ts wires them. `tabs={false}` drops
 * the tabs for a page that has one shared switch (PackageManagerSwitch) instead.
 */
import { installCommands, library as libraryEntry, type LibraryName } from "../libraries.ts";

type Props = { library: LibraryName; tabs?: boolean };

const { library, tabs = true } = Astro.props;
const commands = installCommands(libraryEntry(library));
---

<div class={`pm${tabs ? "" : " pm--bare"}`} data-install data-commands={JSON.stringify(commands)}>
  {
    tabs && (
      <div class="pm__tabs" role="tablist" aria-label="Package manager">
        {Object.keys(commands).map((pm) => (
          <button
            type="button"
            class="pm__tab"
            data-pm={pm}
            role="tab"
            aria-selected={String(pm === "bun")}
          >
            {pm}
          </button>
        ))}
      </div>
    )
  }
  <div class="install__code">
    <code class="install__command">{commands.bun}</code>
    <button type="button" class="install__copy" aria-label={`Copy the ${library} install command`}>
      <svg class="install__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="9" y="9" width="12" height="12" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
    </button>
  </div>
</div>
