---
/**
 * The header on every page: the kit, a menu of the packages (with this page's one open, or
 * "Packages" on the kit's own pages), the demo's integration switch, project links, and the
 * theme toggle. On a demo it floats over the scene. On a phone the project links move into the
 * package menu.
 */
import { LIBRARIES, type LibraryName, REPO_URL } from "../libraries.ts";
import { url } from "../paths.ts";
import LinkIcon from "./LinkIcon.astro";

type Props = {
  /** The page's library; the kit's own pages leave it out. */
  library?: LibraryName;
  /** Show the vanilla / r3f switch: a demo page. */
  demo?: boolean;
  /** This page's other view of the library, if it has one: its demo or its README. */
  alternate?: { href: string; label: string };
  /** The library name is the page's h1 (a demo); a README page has its own. */
  heading?: boolean;
};

const { library, demo = false, alternate, heading = false } = Astro.props;
const Title = heading ? "h1" : "span";
const repo = library ? `${REPO_URL}/tree/main/packages/${library}` : REPO_URL;
const npm = library
  ? `https://www.npmjs.com/package/@zkmake/${library}`
  : "https://www.npmjs.com/org/zkmake";
const npmx = library
  ? `https://npmx.dev/package/@zkmake/${library}`
  : "https://npmx.dev/org/zkmake";
const links: {
  href: string;
  label: string;
  icon: "demo" | "docs" | "github" | "npm" | "npmx";
  external: boolean;
}[] = [
  ...(alternate
    ? [
        {
          ...alternate,
          icon: alternate.label === "demo" ? ("demo" as const) : ("docs" as const),
          external: false,
        },
      ]
    : []),
  { href: repo, label: "GitHub", icon: "github", external: true },
  { href: npm, label: "npm", icon: "npm", external: true },
  { href: npmx, label: "npmx", icon: "npmx", external: true },
];
const external = { target: "_blank", rel: "noreferrer" };
---

<header class={`bar${demo ? " bar--float" : ""}${library ? " bar--package" : ""}`}>
  <div class="bar__group">
    <a class="kit" href={url()}>
      <img class="kit__mark" src={url("favicon.svg")} alt="" width="18" height="18" />
      <span class="kit__name">three-kit</span>
    </a>
    {
      library && (
        <span class="crumb" aria-hidden="true">
          /
        </span>
      )
    }
    <details class="menu">
      <summary
        class="menu__button"
        aria-label={library ? `${library}: switch package` : "Packages"}
      >
        {library ? <Title class="brand">{library}</Title> : <span>Packages</span>}
        <svg class="menu__chevron" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ul class="menu__list">
        {LIBRARIES.map((entry) => (
          <li>
            <a
              class="menu__item"
              href={url(`${entry.name}/`)}
              aria-current={entry.name === library ? "page" : undefined}
            >
              <img src={url(`${entry.name}/favicon.svg`)} alt="" width="16" height="16" />
              <span class="menu__name">{entry.name}</span>
              <span class="menu__version">{entry.version}</span>
              <span class="menu__job">{entry.job}</span>
            </a>
          </li>
        ))}
        {/* Phones: the project links live here, so the bar stays one row. */}
        <li class="menu__links">
          {links.map((link) => (
            <a class="menu__link" href={link.href} {...(link.external ? external : {})}>
              <LinkIcon icon={link.icon} />
              {link.label}
            </a>
          ))}
        </li>
      </ul>
    </details>
    {
      demo && (
        <div id="demo" class="segment" role="radiogroup" aria-label="Integration">
          <button
            type="button"
            class="segment__option"
            data-demo="vanilla"
            role="radio"
            aria-checked="false"
            title="Plain three.js"
          >
            vanilla
          </button>
          <button
            type="button"
            class="segment__option"
            data-demo="r3f"
            role="radio"
            aria-checked="false"
            title="React Three Fiber"
          >
            r3f
          </button>
        </div>
      )
    }
    <nav class="links" aria-label="Project links">
      {
        links.map((link) => (
          <a class="link" href={link.href} {...(link.external ? external : {})}>
            <LinkIcon icon={link.icon} />
            <span class="link__label">{link.label}</span>
          </a>
        ))
      }
    </nav>
  </div>
  <div class="bar__group">
    <div id="theme" class="segment" role="radiogroup" aria-label="Site theme">
      <button
        type="button"
        class="segment__option"
        data-mode="light"
        aria-label="Light theme"
        title="Light theme"
        role="radio"
        aria-checked="false"
      >
        <svg class="segment__icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
      </button>
      <button
        type="button"
        class="segment__option"
        data-mode="system"
        aria-label="Follow the system theme"
        title="Follow the system theme"
        role="radio"
        aria-checked="false"
      >
        <svg class="segment__icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"></rect>
          <path d="M8 21h8M12 17v4"></path>
        </svg>
      </button>
      <button
        type="button"
        class="segment__option"
        data-mode="dark"
        aria-label="Dark theme"
        title="Dark theme"
        role="radio"
        aria-checked="false"
      >
        <svg class="segment__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
    <!-- Phones: one button that steps light → system → dark, so the bar stays one row. -->
    <button type="button" id="theme-cycle" class="theme-cycle" data-mode="system" title="Change theme">
      <svg class="segment__icon theme-cycle__light" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path>
      </svg>
      <svg class="segment__icon theme-cycle__system" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
        <path d="M8 21h8M12 17v4"></path>
      </svg>
      <svg class="segment__icon theme-cycle__dark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import "../scripts/menu.ts";
</script>
